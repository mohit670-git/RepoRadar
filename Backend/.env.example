# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/reporadar
# Atlas:  paste the connection string from your MongoDB Atlas dashboard
MONGO_URI=mongodb://127.0.0.1:27017/reporadar

# ---- Auth ----
# Secret used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- GitHub ----
# Fine-grained personal access token with read access to repository contents.
GITHUB_TOKEN=github_pat_replace_me

# ---- Groq (LLM inference) ----
GROQ_API_KEY=gsk_replace_me

# ---- Brevo (transactional email) ----
BREVO_API_KEY=replace-with-a-brevo-api-key
BREVO_EMAIL_USER=replace-with-your-brevo-login-email

# ---- SMTP / email (fallback transport) ----
EMAIL_USER=replace-with-your-email
EMAIL_PASS=replace-with-your-email-password
